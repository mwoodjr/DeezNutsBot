# Copy to .env locally. Never commit real values.
DISCORD_TOKEN=replace_with_new_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
MONGODB_URI=mongodb://127.0.0.1:27017/discord_bot
CONNECT_MONGODB=true
DEV=false
# Optional; only /chucknorris requires this key.
RAPIDAPI_KEY=
# Configure these links for your own installation.
SUPPORT_URL=https://example.com/support
UPVOTE_URL=https://example.com/vote
# INVITE_URL is generated from DISCORD_CLIENT_ID unless explicitly set.
